[
  {
    $match:
    /**
     * query: The query in MQL.
     */
    {
      startTime: {
        $gt: ISODate("2025-04-30")
      }
    }
  },
  {
    $project:
    /**
     * specifications: The fields to
     *   include or exclude.
     */
    {
      startTime: 1,
      hostname: 1,
      pid: 1
    }
  },
  {
    $out:
    /**
     * Provide the name of the output database and collection.
     */
    {
      db: "aggregates",
      coll: "pool"
      /*
  timeseries: {
  timeField: 'field',
  bucketMaxSpanSeconds: 'number',
  granularity: 'granularity'
  }
  */
    }
  }
]